ALTER TABLE transactions 
ADD 
    hasDDETOS INTEGER DEFAULT 0,
    DDETOSexpiryDate DATE NULL, 
    DDETOSrefNo NVARCHAR(MAX) NULL,
    DDETOScommittedDate DATE NULL,
    DDETOSpreparedBy NVARCHAR(MAX) NULL,
    DDETOSpreparedByDesignation NVARCHAR(MAX) NULL,
    DDETOSnotedBy NVARCHAR(MAX) NULL,
    DDETOSnotedByDesignation NVARCHAR(MAX) NULL,
    DDETOSstatus NVARCHAR(MAX) DEFAULT 'OPEN';



ALTER TABLE transaction_details
ADD 
    isDDETOS INTEGER DEFAULT 0,
    DDETOSrefNo NVARCHAR(MAX) NULL,
    DDETOScommittedDate DATE NULL,
    DDETOSstatus NVARCHAR(MAX) DEFAULT 'OPEN',
    qty_closed DECIMAL (16,2) DEFAULT 0;









